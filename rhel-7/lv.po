"nodalījumus var pārbaudīt ar fsck un montēt manuāli.\n"

#: pyanaconda/rescue.py:358
#, python-format
msgid ""
"Your system has been mounted under %(mountpoint)s.\n"
"\n"
"If you would like to make your system the root environment, run the "
"command:\n"
"\n"
"\tchroot %(mountpoint)s\n"
msgstr ""
"Jūsu sistēma ir montēta zem %(mountpoint)s.\n"
"\n"
"Ja vēlaties padarīt savu sistēmu par saknes vidi, palaidiet komandu:\n"
"\n"
"\tchroot %(mountpoint)s\n"

#: pyanaconda/rescue.py:397
#, python-format
msgid "Run %s to unmount the system when you are finished.\n"
msgstr "Kad esat pabeiguši, palaidiet %s, lai atmontētu sistēmu.\n"

