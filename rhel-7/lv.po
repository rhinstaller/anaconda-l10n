#: data/liveinst/gnome/fedora-welcome:65
msgid "Welcome to Fedora"
msgstr "Sveicināti Fedora"

#: anaconda:490
#, python-format
msgid ""
"%(product_name)s requires %(needed_ram)s MB of memory to install, but you "
"only have %(total_ram)s MB on this machine.\n"
msgstr ""
"%(product_name)s instalēšanai vajag %(needed_ram)s MB atmiņas, bet šajā "
"datorā ir tikai %(total_ram)s MB.\n"

#: anaconda:492
#, python-format
msgid ""
"The %(product_name)s graphical installer requires %(needed_ram)s MB of "
"memory, but you only have %(total_ram)s MB\n"
"."
msgstr ""
"%(product_name)s grafiskajam instalētājam vajag %(needed_ram)s MB atmiņas, "
"bet ir tikai %(total_ram)s MB\n"
"."

#: anaconda:495
msgid ""
"\n"
"Press <return> to reboot your system.\n"
msgstr ""
"\n"
"Nospiediet <return>, lai pārstartētu sistēmu.\n"

#: anaconda:497
msgid "Not enough RAM"
msgstr "Nepietiek RAM"

#: anaconda:498
msgid ""
" Try the text mode installer by running:\n"
"\n"
"'/usr/bin/liveinst -T'\n"
"\n"
" from a root terminal."
msgstr ""
" Mēģiniet teksta režīma instalētāju, palaižot:\n"
"\n"
"'/usr/bin/liveinst -T'\n"
"\n"
" root terminālī."

#: anaconda:501
msgid " Starting text mode."
msgstr " Palaiž teksta režīmu."

#: anaconda:537
msgid "The installation cannot continue and the system will be rebooted"
msgstr "Instalēšanu nevar turpināt, un sistēma tiks pārstartēta"

#: anaconda:664
msgid "DISPLAY variable not set. Starting text mode."
msgstr "Mainīgais DISPLAY nav iestatīts. Palaiž teksta režīmu."

#: anaconda:672
msgid "Graphical installation is not available. Starting text mode."
msgstr "Grafiskā instalēšana nav pieejama. Palaiž teksta režīmu."

#: anaconda:680
msgid ""
"Text mode provides a limited set of installation options. It does not offer "
"custom partitioning for full control over the disk layout. Would you like to "
"use VNC mode instead?"
msgstr ""
"Teksta režīmā ir ierobežots instalēšanas iespēju kopums. Tajā nav pielāgotas "
"nodalīšanas pilnīgai disku izkārtojuma kontrolei. Vai tā vietā vēlaties "
"lietot VNC režīmu?"

#: anaconda:776
#, python-format
msgid "Please ssh install@%s to begin the install."
msgstr "Lūdzu, izpildiet ssh install@%s, lai sāktu instalēšanu."

#: anaconda:778
msgid "Please ssh install@<host> to continue installation."
msgstr "Lūdzu, izpildiet ssh install@<resursdators>, lai turpinātu instalēšanu."

#: data/liveinst/gnome/fedora-welcome:94
msgid "Try Fedora"
msgstr "Izmēģināt Fedora"

#: data/liveinst/gnome/fedora-welcome:110
msgid ""
"You are currently running Fedora from live media.\n"
"You can install Fedora now, or choose \"Install to Hard Drive\" in the "
"Activities Overview at any later time."
msgstr ""
"Pašlaik Fedora darbojas no live datu nesēja.\n"
"Fedora var instalēt tagad vai jebkurā vēlākā laikā izvēlēties „Instalēt "
"cietajā diskā” darbību pārskatā."

#: data/liveinst/gnome/fedora-welcome:128
msgid ""
"You can choose \"Install to Hard Drive\"\n"
"in the Activities Overview at any later time."
msgstr ""
"Jebkurā vēlākā laikā varat izvēlēties „Instalēt cietajā diskā”\n"
"darbību pārskatā."

#: data/liveinst/gnome/fedora-welcome:131
msgid "Close"
msgstr "Aizvērt"
