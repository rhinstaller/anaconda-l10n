#: pyanaconda/modules/storage/platform.py:80
#: pyanaconda/modules/storage/platform.py:386
msgid "You must include at least one disk as an install target."
msgstr "Du må ta med minst éin disk som installasjonsmål."

#: pyanaconda/modules/storage/platform.py:154
msgid ""
"You must include at least one MBR- or GPT-formatted disk as an install "
"target."
msgstr ""
"Du må ta med minst éin MBR- eller GPT-formatert disk som installasjonsmål."

#: pyanaconda/modules/storage/platform.py:196
msgid ""
"For a UEFI installation, you must include an EFI System Partition on a GPT-"
"formatted disk, mounted at /boot/efi."
msgstr ""
"Ved UEFI-installasjon må du ha ein EFI-systempartisjon på ein GPT-formatert "
"disk, montert på /boot/efi."

#: pyanaconda/modules/storage/platform.py:249
msgid ""
"For a UEFI installation, you must include a Linux HFS+ ESP on a GPT-"
"formatted disk, mounted at /boot/efi."
msgstr ""

#: pyanaconda/modules/storage/platform.py:315
msgid ""
"You must include a PReP Boot Partition within the first 4GiB of an MBR- or "
"GPT-formatted disk."
msgstr ""
"Du må ha ein PReP-oppstartspartisjon innanfor dei første 4 GiB på ein MBR- "
"eller GPT-formatert disk."

#: pyanaconda/modules/storage/platform.py:354
msgid ""
"You must include an Apple Bootstrap Partition on an Apple Partition Map-"
"formatted disk."
msgstr ""
"Du må ha ein Apple Bootstrap-partisjon på ein disk formatert med Apple "
"Partition Map."

#: pyanaconda/modules/storage/platform.py:404
msgid ""
"You must include at least one MBR- or DASD-formatted disk as an install "
"target."
msgstr ""
"Du må ta med minst éin MBR- eller DASD-formatert disk som installasjonsmål."

#: pyanaconda/modules/storage/platform.py:442
msgid "You must include at least one MBR-formatted disk as an install target."
msgstr "Du må ta med minst éin MBR-formatert disk som installasjonsmål."

#: pyanaconda/modules/storage/kickstart.py:65
msgid "File system type \"{}\" given in autopart command is invalid."
msgstr "Filsystemtypen «{}» i kommandoen autopart er ugyldig."

#: pyanaconda/modules/storage/kickstart.py:81
msgid "Btrfs file system is not supported."
msgstr "Btrfs-filsystemet er ikkje støtta."

#: pyanaconda/modules/storage/kickstart.py:104
msgid ""
"Disklabel \"{}\" given in clearpart command is not supported on this "
"platform."
msgstr ""
"Disketiketten «{}» som er oppgjeven i kommandoen clearpart, er ikkje støtta "
"på denne plattforma."

#: pyanaconda/modules/storage/kickstart.py:110
msgid "Disk \"{}\" given in clearpart command does not exist."
msgstr "Disken «{}» som er oppgjeven i kommandoen clearpart, finst ikkje."

#: pyanaconda/modules/storage/kickstart.py:115
msgid "Device \"{}\" given in clearpart device list does not exist."
msgstr ""
"Eininga «{}» som er oppgjeven i einingslista til clearpart, finst ikkje."

#: pyanaconda/modules/storage/kickstart.py:134
#: pyanaconda/modules/storage/kickstart.py:139
msgid "Disk \"{}\" given in ignoredisk command does not exist."
msgstr "Disken «{}» som er oppgjeven i kommandoen ignoredisk, finst ikkje."

#: pyanaconda/modules/storage/kickstart.py:149
msgid "NIC \"{}\" given in fcoe command does not exist."
msgstr "NIC-en «{}» som er oppgjeven i kommandoen fcoe, finst ikkje."

#: pyanaconda/modules/storage/kickstart.py:174
#, python-brace-format
msgid ""
"Network interface \"{nic}\" required by iSCSI \"{iscsi_target}\" target is "
"not up."
msgstr ""
"Nettverksgrensesnittet «{nic}» som iSCSI-målet «{iscsi_target}» krev, er "
"ikkje oppe."

#: pyanaconda/modules/storage/kickstart.py:190
msgid ""
"iscsi --iface must be specified (binding used) either for all targets or for "
"none"
msgstr ""
"iscsi --iface må vere spesifisert (kopling brukt) anten for alle mål eller "
"ingen"

#: pyanaconda/modules/storage/kickstart.py:228
#: pyanaconda/modules/storage/kickstart.py:240
