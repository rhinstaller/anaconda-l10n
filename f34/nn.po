msgstr ""

#: pyanaconda/modules/storage/kickstart.py:245
msgid "Disk \"{}\" given in nvdimm command does not exist."
msgstr ""

#: pyanaconda/modules/storage/kickstart.py:258
msgid ""
"Incorrectly specified origin of the snapshot. Use format \"VolGroup/LV-name\""
msgstr "Feil oppgjeve opphav til snapshotet. Bruk formatet «VolGroup/LV-namn»"

#: pyanaconda/modules/storage/bootloader/base.py:183
msgid "/boot file system"
msgstr "/boot-filsystem"

#: pyanaconda/modules/storage/bootloader/base.py:323
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following raid "
"levels: %(raid_level)s."
msgstr ""
"RAID-sett som inneheld «%(desc)s», må ha eitt av desse RAID-nivåa: %"
"(raid_level)s."

#: pyanaconda/modules/storage/bootloader/base.py:331
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following metadata "
"versions: %(metadata_versions)s."
msgstr ""
"RAID-sett som inneheld «%(desc)s», må ha ein av desse metadataversjonane: %"
"(metadata_versions)s."

#: pyanaconda/modules/storage/bootloader/base.py:339
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following device "
"types: %(types)s."
msgstr ""
"RAID-sett som inneheld «%(desc)s», må ha ein av desse einingstypane: %(types)"
"s."

#: pyanaconda/modules/storage/bootloader/base.py:355
#, python-format
msgid "%(name)s must have one of the following disklabel types: %(types)s."
msgstr "%(name)s må ha ein av desse disketiketttypane: %(types)s."

#: pyanaconda/modules/storage/bootloader/base.py:367
#, python-format
msgid "%(desc)s cannot be of type %(type)s."
msgstr "%(desc)s kan ikkje vere av typen %(type)s."

#: pyanaconda/modules/storage/bootloader/base.py:373
#, python-format
msgid "%(desc)s must be mounted on one of %(mountpoints)s."
msgstr "%(desc)s må monterast på ein av %(mountpoints)s."

#: pyanaconda/modules/storage/bootloader/base.py:385
#, python-format
msgid "%(desc)s must be between %(min)d and %(max)d MB in size"
msgstr "%(desc)s må vere mellom %(min)d og %(max)d MB stor"

#: pyanaconda/modules/storage/bootloader/base.py:391
#, python-format
msgid "%(desc)s must not be smaller than %(min)dMB."
msgstr "%(desc)s må ikkje vere mindre enn %(min)dMB."

#: pyanaconda/modules/storage/bootloader/base.py:400
#, python-format
msgid "%(desc)s must not be larger than %(max)dMB."
msgstr "%(desc)s må ikkje vere større enn %(max)dMB."

#: pyanaconda/modules/storage/bootloader/base.py:418
#, python-format
msgid "%(desc)s must be within the first %(max_end)s of the disk."
msgstr "%(desc)s må vere innanfor dei første %(max_end)s av disken."

#: pyanaconda/modules/storage/bootloader/base.py:428
#, python-format
msgid "%s must be on a primary partition."
msgstr "%s må liggje på ein primærpartisjon."

#: pyanaconda/modules/storage/bootloader/base.py:517
msgid ""
"Boot loader stage1 device cannot be on an iSCSI disk which is not configured "
"in iBFT."
msgstr ""
"Steg 1-eininga for oppstartslastaren kan ikkje liggje på ein iSCSI-disk som "
"ikkje er sett opp i iBFT."

#: pyanaconda/modules/storage/bootloader/base.py:573
#: pyanaconda/modules/storage/bootloader/base.py:689
#, python-format
msgid "%s cannot be on an encrypted block device."
msgstr "%s kan ikkje liggje på ei kryptert blokkeining."

#: pyanaconda/modules/storage/bootloader/base.py:641
#, python-format
msgid ""
"%(bootloader_stage2_description)s cannot be on an iSCSI disk which is not "
"configured in iBFT."
msgstr ""
"%(bootloader_stage2_description)s kan ikkje liggje på ein iSCSI-disk som "
"ikkje er sett opp i iBFT."

#: pyanaconda/modules/storage/bootloader/base.py:648
#, python-format
msgid "%(desc)s cannot be of type %(type)s"
msgstr "%(desc)s kan ikkje vere av typen %(type)s"

#: pyanaconda/modules/storage/bootloader/execution.py:185
msgid "No match found for given boot drive \"{}\"."
msgstr "Fann ikkje treff for oppstart-disk \"{}\"."

#: pyanaconda/modules/storage/bootloader/execution.py:189
msgid "More than one match found for given boot drive \"{}\"."
msgstr "Meir enn eitt treff for spesifisert oppstart-disk \"{}\"."

#: pyanaconda/modules/storage/bootloader/execution.py:193
msgid "Requested boot drive \"{}\" doesn't exist or cannot be used."
msgstr "Førespurt oppstart-disk \"{}\" finst ikkje eller kan ikkje verte brukt."

#: pyanaconda/modules/storage/bootloader/bootloader.py:172
msgid "GRUB2 does not support installation to a partition."
msgstr "GRUB2 støttar ikkje installasjon til ein partisjon."

#: pyanaconda/modules/storage/bootloader/bootloader.py:179
msgid "GRUB2 encrypted password must be in grub.pbkdf2 format."
msgstr "GRUB2-kryptert passord må vere i formatet grub2pbkdf2."

#: pyanaconda/modules/storage/bootloader/grub2.py:486
#, python-format
msgid ""
"%(deviceName)s may not have enough space for grub2 to embed core.img when "
"using the %(fsType)s file system on %(deviceType)s"
msgstr ""
"%(deviceName)s har kanskje ikkje nok plass til at grub2 kan byggje inn "
"core.img når filsystemet %(fsType)s vert brukt på %(deviceType)s"

#: pyanaconda/modules/storage/bootloader/grub2.py:525
#, python-format
msgid ""
"boot loader stage2 device %(stage2dev)s is on a multi-disk array, but boot "
"loader stage1 device %(stage1dev)s is not. A drive failure in %(stage2dev)s "
"could render the system unbootable."
msgstr ""
"Steg 2-eininga %(stage2dev)s for oppstartslastaren ligg på ein "
"fleirdiskmatrise, men steg 1-eininga %(stage1dev)s gjer ikkje det. Ein "
"diskfeil i %(stage2dev)s kan gjere at systemet ikkje kan startast."

#: pyanaconda/modules/storage/bootloader/grub2.py:532
#, python-format
msgid ""
"boot loader stage2 device %(stage2dev)s is on a multi-disk array, but boot "
"loader stage1 device %(stage1dev)s is not part of this array. The stage1 "
"boot loader will only be installed to a single drive."
msgstr ""
"Steg 2-eininga %(stage2dev)s for oppstartslastaren ligg på ein "
"fleirdiskmatrise, men steg 1-eininga %(stage1dev)s er ikkje ein del av "
"matrisa. Steg 1 av oppstartslastaren vert berre installert på éin stasjon."

