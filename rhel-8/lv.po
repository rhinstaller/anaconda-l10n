msgstr "Komandas harddrive parametrs --biospart netiek atbalstīts!"

#: pyanaconda/modules/payloads/source/hmc/hmc.py:53
msgid "Local media via SE/HMC"
msgstr "Lokālais datu nesējs caur SE/HMC"

