#: pyanaconda/core/storage.py:108
msgid ""
"The 'swap' area on your computer is used by the operating\n"
"system when running low on memory."
msgstr ""
"Datora „swap” apgabalu operētājsistēma lieto,\n"
"kad pietrūkst atmiņas."

#: pyanaconda/core/storage.py:110
msgid ""
"The 'boot' area on your computer is where files needed\n"
"to start the operating system are stored."
msgstr ""
"Datora „boot” apgabalā glabājas faili, kas vajadzīgi\n"
"operētājsistēmas palaišanai."

#: pyanaconda/core/storage.py:112
msgid ""
"The 'root' area on your computer is where core system\n"
"files and applications are stored."
msgstr ""
"Datora „root” apgabalā glabājas galvenie sistēmas\n"
"faili un lietotnes."

#: pyanaconda/core/storage.py:114
msgid ""
"The 'home' area on your computer is where all your personal\n"
"data is stored."
msgstr ""
"Datora „home” apgabalā glabājas visi Jūsu personiskie\n"
"dati."

#: pyanaconda/core/storage.py:116
msgid ""
"The BIOS boot partition is required to enable booting\n"
"from GPT-partitioned disks on BIOS hardware."
msgstr ""
"BIOS sāknēšanas nodalījums ir nepieciešams, lai BIOS aparatūrā\n"
"varētu sāknēt no GPT nodalītiem diskiem."

#: pyanaconda/core/storage.py:118
msgid ""
"The PReP boot partition is required as part of the\n"
"boot loader configuration on some PPC platforms."
msgstr ""
"Dažās PPC platformās PReP sāknēšanas nodalījums ir nepieciešams\n"
"kā daļa no sāknētāja konfigurācijas."

#: pyanaconda/core/users.py:66
#, python-format
msgid "User name is reserved for system: %s"
msgstr "Lietotājvārds ir rezervēts sistēmai: %s"

#: pyanaconda/core/users.py:90
msgid ""
"Either a group name in the group list is invalid or groups are not separated "
"by a comma."
msgstr ""
"Kāds grupas nosaukums grupu sarakstā nav derīgs, vai grupas nav atdalītas ar "
"komatu."

#: pyanaconda/core/users.py:122
msgid "Name cannot start with '-' character."
msgstr "Nosaukums nedrīkst sākties ar rakstzīmi „-”."

#: pyanaconda/core/users.py:125
#, python-format
msgid "Name '%s' is not allowed."
msgstr "Nosaukums „%s” nav atļauts."

#: pyanaconda/core/users.py:128
msgid "Fully numeric name is not allowed."
msgstr "Tikai ciparu nosaukums nav atļauts."

#: pyanaconda/core/users.py:132
msgid "Name '$' is not allowed."
msgstr "Nosaukums „$” nav atļauts."

#: pyanaconda/core/users.py:142
#, python-format
msgid "Name cannot contain character: '%s'"
msgstr "Nosaukumā nedrīkst būt rakstzīme „%s”"

#: pyanaconda/core/users.py:145
msgid "Name must be shorter than 33 characters."
msgstr "Nosaukumam jābūt īsākam par 33 rakstzīmēm."

#: pyanaconda/core/users.py:149
#, python-format
msgid "Name '%s' is invalid."
msgstr "Nosaukums „%s” nav derīgs."

#: pyanaconda/modules/network/firewall/installation.py:102
