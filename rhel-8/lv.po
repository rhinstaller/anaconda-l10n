msgstr "Paroles frāzes nesakrīt."

#: pyanaconda/core/constants.py:214
msgid "The passwords you entered were different. Please try again."
msgstr "Ievadītās paroles atšķīrās. Lūdzu, mēģiniet vēlreiz."

#: pyanaconda/core/constants.py:215
msgid "The passphrases you entered were different. Please try again."
msgstr "Ievadītās paroles frāzes atšķīrās. Lūdzu, mēģiniet vēlreiz."

#: pyanaconda/core/constants.py:221
msgid "The password is too short"
msgstr "Parole ir pārāk īsa"

#: pyanaconda/core/constants.py:222
msgid "The passphrase is too short"
msgstr "Paroles frāze ir pārāk īsa"

#: pyanaconda/core/constants.py:225
msgid "The password you have provided is weak."
msgstr "Ievadītā parole ir vāja."

#: pyanaconda/core/constants.py:226
msgid "The passphrase you have provided is weak."
msgstr "Ievadītā paroles frāze ir vāja."

#: pyanaconda/core/constants.py:229
msgid "The password you have provided is weak:"
msgstr "Ievadītā parole ir vāja:"

#: pyanaconda/core/constants.py:230
msgid "The passphrase you have provided is weak:"
msgstr "Ievadītā paroles frāze ir vāja:"

#: pyanaconda/core/constants.py:232
msgid "Press <b>Done</b> again to use the password anyway."
msgstr "Vēlreiz nospiediet <b>Gatavs</b>, lai tomēr lietotu šo paroli."

#: pyanaconda/core/constants.py:234
msgid ""
"The password you have provided contains non-ASCII characters. You may not be "
"able to switch between keyboard layouts when typing it."
msgstr ""
"Ievadītā parole satur ne-ASCII rakstzīmes. To ievadot, iespējams, nevarēsiet "
"pārslēgt tastatūras izkārtojumus."

#: pyanaconda/core/constants.py:235
msgid ""
"The passphrase you have provided contains non-ASCII characters. You may not "
"be able to switch between keyboard layouts when typing it."
msgstr ""
"Ievadītā paroles frāze satur ne-ASCII rakstzīmes. To ievadot, iespējams, "
"nevarēsiet pārslēgt tastatūras izkārtojumus."

#: pyanaconda/core/constants.py:237
msgid "You will have to press <b>Done</b> twice to confirm it."
msgstr "Lai to apstiprinātu, <b>Gatavs</b> būs jānospiež divreiz."

