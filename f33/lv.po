#: anaconda.py:378
msgid "Unable to create PID file"
msgstr "Neizdevās izveidot PID failu"

#: anaconda.py:379
#, python-format
msgid ""
"Anaconda is unable to create %s because the file already exists. Anaconda is "
"already running, or a previous instance of anaconda has crashed."
msgstr ""
"Anaconda neizdevās izveidot %s, jo fails jau eksistē. Anaconda jau darbojas, "
"vai arī iepriekšējais anaconda eksemplārs ir avarējis."

#: pyanaconda/modules/timezone/timezone.py:100
msgid "Invalid time source."
msgstr "Nederīgs laika avots."

#: pyanaconda/modules/storage/kickstart.py:65
msgid "File system type \"{}\" given in autopart command is invalid."
msgstr "Komandā autopart norādītais failu sistēmas tips „{}” nav derīgs."

#: pyanaconda/modules/storage/kickstart.py:81
msgid "Btrfs file system is not supported."
msgstr "Btrfs failu sistēma netiek atbalstīta."

#: pyanaconda/modules/storage/kickstart.py:104
msgid ""
"Disklabel \"{}\" given in clearpart command is not supported on this "
"platform."
msgstr ""
"Diska etiķete „{}”, kas norādīta komandā clearpart, šajā platformā netiek "
"atbalstīta."

#: pyanaconda/modules/storage/kickstart.py:110
msgid "Disk \"{}\" given in clearpart command does not exist."
msgstr "Disks „{}”, kas norādīts komandā clearpart, neeksistē."

#: pyanaconda/modules/storage/kickstart.py:115
msgid "Device \"{}\" given in clearpart device list does not exist."
msgstr "Ierīce „{}”, kas norādīta clearpart ierīču sarakstā, neeksistē."

#: pyanaconda/modules/storage/kickstart.py:134
#: pyanaconda/modules/storage/kickstart.py:139
msgid "Disk \"{}\" given in ignoredisk command does not exist."
msgstr "Disks „{}”, kas norādīts komandā ignoredisk, neeksistē."

#: pyanaconda/modules/storage/kickstart.py:149
msgid "NIC \"{}\" given in fcoe command does not exist."
msgstr "Komandā fcoe norādītā tīkla karte „{}” neeksistē."

#: pyanaconda/modules/storage/kickstart.py:174
#, python-brace-format
msgid ""
"Network interface \"{nic}\" required by iSCSI \"{iscsi_target}\" target is "
"not up."
msgstr ""
"Tīkla saskarne „{nic}”, kas nepieciešama iSCSI mērķim „{iscsi_target}”, nav "
"aktīva."

#: pyanaconda/modules/storage/kickstart.py:190
msgid ""
"iscsi --iface must be specified (binding used) either for all targets or for "
"none"
msgstr ""
"iscsi --iface jānorāda (lietojot piesaisti) vai nu visiem mērķiem, vai "
"nevienam"

#: pyanaconda/modules/storage/kickstart.py:228
#: pyanaconda/modules/storage/kickstart.py:240
msgid "Namespace \"{}\" given in nvdimm command was not found."
msgstr "Nosaukumvieta „{}”, kas norādīta komandā nvdimm, nav atrasta."

#: pyanaconda/modules/storage/kickstart.py:245
msgid "Disk \"{}\" given in nvdimm command does not exist."
msgstr "Disks „{}”, kas norādīts komandā nvdimm, neeksistē."

#: pyanaconda/modules/storage/kickstart.py:258
msgid ""
"Incorrectly specified origin of the snapshot. Use format \"VolGroup/LV-name\""
msgstr ""
"Nepareizi norādīta momentuzņēmuma izcelsme. Lietojiet formātu „VolGroup/LV-"
"name”"

#: pyanaconda/modules/storage/bootloader/execution.py:185
msgid "No match found for given boot drive \"{}\"."
msgstr "Norādītajam sāknēšanas diskam „{}” nav atrasta atbilstība."

#: pyanaconda/modules/storage/bootloader/execution.py:189
msgid "More than one match found for given boot drive \"{}\"."
msgstr ""
"Norādītajam sāknēšanas diskam „{}” atrasta vairāk nekā viena atbilstība."

#: pyanaconda/modules/storage/bootloader/execution.py:193
msgid "Requested boot drive \"{}\" doesn't exist or cannot be used."
msgstr "Pieprasītais sāknēšanas disks „{}” neeksistē vai nav lietojams."

#: pyanaconda/modules/storage/bootloader/grub2.py:487
#, python-format
msgid ""
"%(deviceName)s may not have enough space for grub2 to embed core.img when "
"using the %(fsType)s file system on %(deviceType)s"
msgstr ""
"%(deviceName)s var nebūt pietiekami daudz vietas, lai grub2 iegultu "
"core.img, lietojot %(fsType)s failu sistēmu ierīcē %(deviceType)s"

#: pyanaconda/modules/storage/bootloader/grub2.py:526
#, python-format
msgid ""
"boot loader stage2 device %(stage2dev)s is on a multi-disk array, but boot "
"loader stage1 device %(stage1dev)s is not. A drive failure in %(stage2dev)s "
"could render the system unbootable."
msgstr ""
"Sāknētāja stage2 ierīce %(stage2dev)s atrodas vairāku disku masīvā, bet "
"sāknētāja stage1 ierīce %(stage1dev)s ne. Diska kļūme ierīcē %(stage2dev)s "
"var padarīt sistēmu nesāknējamu."

#: pyanaconda/modules/storage/bootloader/grub2.py:533
#, python-format
msgid ""
"boot loader stage2 device %(stage2dev)s is on a multi-disk array, but boot "
"loader stage1 device %(stage1dev)s is not part of this array. The stage1 "
"boot loader will only be installed to a single drive."
msgstr ""
"Sāknētāja stage2 ierīce %(stage2dev)s atrodas vairāku disku masīvā, bet "
"sāknētāja stage1 ierīce %(stage1dev)s nav šī masīva daļa. Stage1 sāknētājs "
"tiks instalēts tikai vienā diskā."

#: pyanaconda/modules/storage/bootloader/bootloader.py:171
msgid "GRUB2 does not support installation to a partition."
msgstr "GRUB2 neatbalsta instalēšanu nodalījumā."

#: pyanaconda/modules/storage/bootloader/bootloader.py:178
msgid "GRUB2 encrypted password must be in grub.pbkdf2 format."
msgstr "GRUB2 šifrētajai parolei jābūt formātā grub.pbkdf2."

#: pyanaconda/modules/storage/bootloader/base.py:180
msgid "/boot file system"
msgstr "/boot failu sistēma"

#: pyanaconda/modules/storage/bootloader/base.py:329
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following raid "
"levels: %(raid_level)s."
msgstr ""
"RAID kopām, kas satur „%(desc)s”, jābūt vienam no šiem RAID līmeņiem: %"
"(raid_level)s."

#: pyanaconda/modules/storage/bootloader/base.py:337
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following metadata "
"versions: %(metadata_versions)s."
msgstr ""
"RAID kopām, kas satur „%(desc)s”, jābūt vienai no šīm metadatu versijām: %"
"(metadata_versions)s."

#: pyanaconda/modules/storage/bootloader/base.py:345
#, python-format
msgid ""
"RAID sets that contain '%(desc)s' must have one of the following device "
"types: %(types)s."
msgstr ""
"RAID kopām, kas satur „%(desc)s”, jābūt vienam no šiem ierīču tipiem: %"
"(types)s."

#: pyanaconda/modules/storage/bootloader/base.py:361
#, python-format
msgid "%(name)s must have one of the following disklabel types: %(types)s."
msgstr "%(name)s jābūt vienam no šiem diska etiķetes tipiem: %(types)s."

#: pyanaconda/modules/storage/bootloader/base.py:373
#, python-format
msgid "%(desc)s cannot be of type %(type)s."
msgstr "%(desc)s nevar būt tipa %(type)s."

#: pyanaconda/modules/storage/bootloader/base.py:379
#, python-format
msgid "%(desc)s must be mounted on one of %(mountpoints)s."
msgstr "%(desc)s jāmontē vienā no %(mountpoints)s."

#: pyanaconda/modules/storage/bootloader/base.py:391
#, python-format
msgid "%(desc)s must be between %(min)d and %(max)d MB in size"
msgstr "%(desc)s izmēram jābūt no %(min)d līdz %(max)d MB"

#: pyanaconda/modules/storage/bootloader/base.py:397
#, python-format
msgid "%(desc)s must not be smaller than %(min)dMB."
msgstr "%(desc)s nedrīkst būt mazāks par %(min)dMB."

#: pyanaconda/modules/storage/bootloader/base.py:406
#, python-format
msgid "%(desc)s must not be larger than %(max)dMB."
msgstr "%(desc)s nedrīkst būt lielāks par %(max)dMB."

#: pyanaconda/modules/storage/bootloader/base.py:424
#, python-format
msgid "%(desc)s must be within the first %(max_end)s of the disk."
msgstr "%(desc)s jāatrodas diska pirmajos %(max_end)s."

#: pyanaconda/modules/storage/bootloader/base.py:434
#, python-format
msgid "%s must be on a primary partition."
msgstr "%s jāatrodas primārajā nodalījumā."

#: pyanaconda/modules/storage/bootloader/base.py:521
msgid ""
"Boot loader stage1 device cannot be on an iSCSI disk which is not configured "
"in iBFT."
msgstr ""
"Sāknētāja stage1 ierīce nevar atrasties iSCSI diskā, kas nav konfigurēts "
"iBFT."

#: pyanaconda/modules/storage/bootloader/base.py:578
#: pyanaconda/modules/storage/bootloader/base.py:694
#, python-format
msgid "%s cannot be on an encrypted block device."
msgstr "%s nevar atrasties šifrētā bloka ierīcē."

#: pyanaconda/modules/storage/bootloader/base.py:646
#, python-format
msgid ""
"%(bootloader_stage2_description)s cannot be on an iSCSI disk which is not "
"configured in iBFT."
msgstr ""
"%(bootloader_stage2_description)s nevar atrasties iSCSI diskā, kas nav "
"konfigurēts iBFT."

#: pyanaconda/modules/storage/bootloader/base.py:653
#, python-format
msgid "%(desc)s cannot be of type %(type)s"
msgstr "%(desc)s nevar būt tipa %(type)s"

#: pyanaconda/modules/storage/platform.py:52
msgid "boot loader device"
msgstr "sāknētāja ierīce"

#: pyanaconda/modules/storage/platform.py:54
msgid "RAID Device"
msgstr "RAID ierīce"

#: pyanaconda/modules/storage/platform.py:55
msgid "First sector of boot partition"
msgstr "Sāknēšanas nodalījuma pirmais sektors"

#: pyanaconda/modules/storage/platform.py:122
#: pyanaconda/modules/storage/platform.py:241
#: pyanaconda/modules/storage/platform.py:257
msgid "Master Boot Record"
msgstr "Galvenais sāknēšanas ieraksts (MBR)"

#: pyanaconda/modules/storage/platform.py:129
msgid ""
"You must include at least one MBR- or GPT-formatted disk as an install "
"target."
msgstr ""
"Kā instalēšanas mērķis jāiekļauj vismaz viens MBR vai GPT formatēts disks."

#: pyanaconda/modules/storage/platform.py:146
msgid "EFI System Partition"
msgstr "EFI sistēmas nodalījums"

#: pyanaconda/modules/storage/platform.py:152
msgid ""
"For a UEFI installation, you must include an EFI System Partition on a GPT-"
"formatted disk, mounted at /boot/efi."
msgstr ""
"UEFI instalācijai GPT formatētā diskā jābūt EFI sistēmas nodalījumam, kas "
"montēts mapē /boot/efi."

#: pyanaconda/modules/storage/platform.py:166
msgid "Apple EFI Boot Partition"
msgstr "Apple EFI sāknēšanas nodalījums"

#: pyanaconda/modules/storage/platform.py:169
msgid ""
"For a UEFI installation, you must include a Linux HFS+ ESP on a GPT-"
"formatted disk, mounted at /boot/efi."
msgstr ""
"UEFI instalācijai GPT formatētā diskā jābūt Linux HFS+ ESP, kas montēts "
"mapē /boot/efi."

#: pyanaconda/modules/storage/platform.py:201
msgid "PReP Boot Partition"
msgstr "PReP sāknēšanas nodalījums"

#: pyanaconda/modules/storage/platform.py:203
msgid ""
"You must include a PReP Boot Partition within the first 4GiB of an MBR- or "
"GPT-formatted disk."
msgstr ""
"MBR vai GPT formatēta diska pirmajos 4GiB jābūt PReP sāknēšanas nodalījumam."

#: pyanaconda/modules/storage/platform.py:215
msgid "Apple Bootstrap Partition"
msgstr "Apple sāknēšanas nodalījums"

#: pyanaconda/modules/storage/platform.py:218
msgid ""
"You must include an Apple Bootstrap Partition on an Apple Partition Map-"
"formatted disk."
msgstr "Apple Partition Map formatētā diskā jābūt Apple sāknēšanas nodalījumam."

#: pyanaconda/modules/storage/platform.py:230
msgid "You must include at least one disk as an install target."
msgstr "Kā instalēšanas mērķis jāiekļauj vismaz viens disks."

#: pyanaconda/modules/storage/platform.py:240
msgid "DASD"
msgstr "DASD"

#: pyanaconda/modules/storage/platform.py:242
msgid "zFCP"
msgstr "zFCP"

#: pyanaconda/modules/storage/platform.py:247
msgid ""
"You must include at least one MBR- or DASD-formatted disk as an install "
"target."
msgstr ""
"Kā instalēšanas mērķis jāiekļauj vismaz viens MBR vai DASD formatēts disks."

#: pyanaconda/modules/storage/platform.py:261
msgid "You must include at least one MBR-formatted disk as an install target."
msgstr "Kā instalēšanas mērķis jāiekļauj vismaz viens MBR formatēts disks."

#: pyanaconda/modules/storage/devicetree/utils.py:68
#, python-format
msgid "Escrow certificate %s requires the network."
msgstr "Depozīta sertifikātam %s nepieciešams tīkls."

#: pyanaconda/modules/storage/devicetree/utils.py:76
#, python-format
msgid ""
"SSL error while downloading the escrow certificate:\n"
"\n"
"%s"
msgstr ""
"SSL kļūda, lejupielādējot depozīta sertifikātu:\n"
"\n"
"%s"

#: pyanaconda/modules/storage/devicetree/utils.py:79
#, python-format
msgid ""
"The following error was encountered while downloading the escrow "
"certificate:\n"
"\n"
"%s"
msgstr ""
"Lejupielādējot depozīta sertifikātu, radās šī kļūda:\n"
"\n"
"%s"

#: pyanaconda/modules/storage/devicetree/viewer.py:303
#, python-brace-format
msgid "{device_description} ({device_name})"
msgstr "{device_description} ({device_name})"

#: pyanaconda/modules/storage/devicetree/viewer.py:309
#, python-brace-format
msgid "{device_name} on {container_name}"
msgstr "{device_name} uz {container_name}"

#: pyanaconda/modules/storage/devicetree/root.py:339
msgid "Unknown Linux"
msgstr "Nezināma Linux"

#: pyanaconda/modules/storage/devicetree/root.py:342
#, python-brace-format
msgid "{product} {version} for {arch}"
msgstr "{product} {version} arhitektūrai {arch}"

#: pyanaconda/modules/storage/devicetree/root.py:344
#, python-brace-format
msgid "{product} Linux {version} for {arch}"
msgstr "{product} Linux {version} arhitektūrai {arch}"

#: pyanaconda/modules/storage/devicetree/fsset.py:390
#, python-brace-format
msgid ""
"There is an entry in your /etc/fstab file that contains an invalid or "
"incorrect file system type. The file says that {detected_type} at "
"{mount_point} is {fstab_type}."
msgstr ""
"Failā /etc/fstab ir ieraksts ar nederīgu vai nepareizu datņu sistēmas tipu. "
"Failā norādīts, ka {detected_type} vietā {mount_point} ir {fstab_type}."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:213
#, python-brace-format
msgid "New {name} {version} Installation"
msgstr "Jauna {name} {version} instalācija"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:289
msgid "Cannot set label on file system."
msgstr "Neizdevās iestatīt failu sistēmas etiķeti."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:292
msgid "Unacceptable label format for file system."
msgstr "Nepieņemams failu sistēmas etiķetes formāts."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:307
msgid "That mount point is already in use. Try something else?"
msgstr "Šis montēšanas punkts jau tiek lietots. Mēģināt ko citu?"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:310
msgid "Please enter a valid mount point."
msgstr "Lūdzu, ievadiet derīgu montēšanas punktu."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:313
#: pyanaconda/modules/storage/partitioning/interactive/utils.py:325
msgid "That mount point is invalid. Try something else?"
msgstr "Šis montēšanas punkts nav derīgs. Mēģināt ko citu?"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:340
msgid "Invalid container name."
msgstr "Nederīgs konteinera nosaukums."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:343
#: pyanaconda/ui/gui/spokes/lib/custom_storage_helpers.py:595
msgid "Name is already in use."
msgstr "Nosaukums jau tiek lietots."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:368
#, python-brace-format
msgid ""
"The RAID level you have selected ({level}) requires more disks ({min}) than "
"you currently have selected ({count})."
msgstr ""
"Atlasītajam RAID līmenim ({level}) vajag vairāk disku ({min}), nekā pašlaik "
"atlasīts ({count})."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:410
msgid "Please enter a mount point."
msgstr "Lūdzu, ievadiet montēšanas punktu."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:423
#, python-brace-format
msgid "/boot/efi must be on a device of type {type} or {another}"
msgstr "/boot/efi jāatrodas ierīcē ar tipu {type} vai {another}"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:430
#, python-brace-format
msgid "{fs} must be on a device of type {type}"
msgstr "{fs} jāatrodas ierīcē ar tipu {type}"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:436
#: pyanaconda/modules/storage/partitioning/interactive/utils.py:439
msgid "{} cannot be encrypted"
msgstr "{} nevar šifrēt"

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:442
#: pyanaconda/modules/storage/checker/utils.py:59
msgid "You must create a new file system on the root device."
msgstr "Saknes ierīcē jāizveido jauna failu sistēma."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:446
msgid "Device does not support RAID level selection {}."
msgstr "Ierīce neatbalsta RAID līmeņa izvēli {}."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:1245
#, python-format
msgid ""
"This Software RAID array is missing %(missing)d of %(total)d member "
"partitions. You can remove it or select a different device."
msgstr ""
"Šim programmatūras RAID masīvam trūkst %(missing)d no %(total)d "
"dalībnodalījumiem. Varat to noņemt vai atlasīt citu ierīci."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:1252
#, python-format
msgid ""
"This LVM Volume Group is missing %(missingPVs)d of %(totalPVs)d physical "
"volumes. You can remove it or select a different device."
msgstr ""
"Šai LVM sējumu grupai trūkst %(missingPVs)d no %(totalPVs)d fiziskajiem "
"sējumiem. Varat to noņemt vai atlasīt citu ierīci."

#: pyanaconda/modules/storage/partitioning/interactive/utils.py:1256
#, python-format
msgid ""
"This %(type)s device is missing member devices. You can remove it or select "
"a different device."
msgstr ""
"Šai %(type)s ierīcei trūkst dalībierīču. Varat to noņemt vai atlasīt citu "
"ierīci."

#: pyanaconda/modules/storage/partitioning/automatic/utils.py:165
msgid "No usable disks selected."
msgstr "Nav atlasīts neviens lietojams disks."

#: pyanaconda/modules/storage/partitioning/automatic/utils.py:168
msgid "Not enough free space on selected disks."
msgstr "Atlasītajos diskos nepietiek brīvas vietas."

#: pyanaconda/modules/storage/partitioning/automatic/utils.py:340
msgid "No big enough free space on disks for automatic partitioning"
msgstr "Diskos nav pietiekami daudz brīvas vietas automātiskajai nodalīšanai"

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:161
#, python-format
msgid "No disk found for specified BIOS disk \"%s\"."
msgstr "Norādītajam BIOS diskam „%s” nav atrasts neviens disks."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:202
#, python-format
msgid "RAID partition \"%s\" is defined multiple times."
msgstr "RAID nodalījums „%s” ir definēts vairākkārt."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:215
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:521
#, python-format
msgid "PV partition \"%s\" is defined multiple times."
msgstr "PV nodalījums „%s” ir definēts vairākkārt."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:228
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:533
#, python-format
msgid "Btrfs partition \"%s\" is defined multiple times."
msgstr "Btrfs nodalījums „%s” ir definēts vairākkārt."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:253
#, python-format
msgid "The size \"%s\" is invalid."
msgstr "Izmērs „%s” nav derīgs."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:262
msgid "part --noformat must also use the --onpart option."
msgstr "part --noformat jālieto arī ar opciju --onpart."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:269
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:379
#, python-format
msgid "Partition \"%s\" given in part command does not exist."
msgstr "Nodalījums „%s”, kas norādīts komandā part, neeksistē."

#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:282
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:293
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:390
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:981
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:992
#: pyanaconda/modules/storage/partitioning/custom/custom_partitioning.py:1057
#, python-format
